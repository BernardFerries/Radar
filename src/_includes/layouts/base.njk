<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ radar.reglages.nom_site }}{% endblock %}</title>
  {% set siteUrl = site.url %}
  {# Pages override only the title/description blocks so each og: tag is emitted exactly once. #}
  <meta property="og:title" content="{% block ogtitle %}{{ radar.reglages.nom_site }}{% endblock %}">
  <meta property="og:description" content="{% block ogdesc %}Le suivi, preuves à l'appui, des {{ radar.total }} promesses de campagne de la majorité municipale d'Escalquens, par Nouveau Cap.{% endblock %}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ siteUrl }}/assets/img/og-default.png">
  <meta name="twitter:card" content="summary_large_image">
  {% if siteUrl %}<link rel="canonical" href="{{ siteUrl }}{{ page.url }}">{% endif %}
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  {% include "partials/header.njk" %}
  <main>
    {% block content %}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
